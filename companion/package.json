{
  "name": "@poolboy/knap-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Poolboy Knap renderer companion: one-shot stdin/stdout JSON render seam.",
  "type": "module",
  "bin": {
    "poolboy-knap": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "commitlint": "commitlint",
    "coverage": "vitest run --coverage",
    "dev": "tsx src/bin/cli.ts",
    "format": "biome check --write .",
    "hooks:check": "lefthook validate",
    "knip": "knip --no-progress",
    "lint": "biome ci .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "knap": "0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
